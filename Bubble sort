import java.util.Scanner;
class Bubble{
    public static void Bubblesort(int arr[])
    {
      for(int i=0;i<arr.length-1;i++)//length 4 loops run 3 (0 to 2)
          {
              for(int j=0;j<arr.length-1-i;j++)//same looping skip last digit of i already Swap.
                  {
                      if(arr[j]>arr[j+1])
                      {
                          int temp=0;
                          temp=arr[j];
                          arr[j]=arr[j+1];
                          arr[j+1]=temp;
                      }
                  }
          }
    }
public static void Printsort(int arr[])
    {
        for(int i=0;i<arr.length;i++)
            System.out.print(arr[i]+" ");
    }
    public static void main(String args[])
    {
